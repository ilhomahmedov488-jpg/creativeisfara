# Copy to .env, fill locally. Never commit .env or private phone bindings.
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Local development can use SQLite. Production requires PostgreSQL:
DATABASE_URL=
SMS_BACKEND=payom
# Full tenant endpoint, supplied by Payom, e.g. https://YOUR_HOST/api/message
PAYOM_URL=
PAYOM_TOKEN=
PAYOM_SENDER=
# Production: DEBUG=false, real hosts and origins, HTTPS reverse proxy.
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY_HTTPS=false
TRUST_CLIENT_IP_HEADER=false
